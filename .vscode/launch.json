{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ScrapingLab: 아마존 상품 수집",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ScrapingLab",
      "program": "${workspaceFolder}/ScrapingLab/bin/Debug/net10.0/ScrapingLab.dll",
      "args": ["https://www.amazon.com/dp/B0FC2C34GY?th=1&psc=1"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "ScrapingLab: URL 입력",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ScrapingLab",
      "program": "${workspaceFolder}/ScrapingLab/bin/Debug/net10.0/ScrapingLab.dll",
      "args": ["${input:targetUrl}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "targetUrl",
      "type": "promptString",
      "description": "수집할 상품의 전체 URL",
      "default": "https://www.amazon.com/dp/B0FC2C34GY?th=1&psc=1"
    }
  ]
}
